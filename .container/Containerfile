FROM docker.io/library/debian:stable-slim@sha256:dd324f2b5d8d63278a0ab2831193c0b2d192bc4d7f7a1879408fc51300546cdb

ENV ANDROID_COMMAND_LINE_TOOLS_VERSION=15859902
ENV ANDROID_PLATFORM_VERSION=36
ENV ANDROID_BUILD_TOOLS_VERSION=36.0.0
ENV ANDROID_NDK_VERSION=27.1.12297006
ENV JAVA_VERSION=21
ENV JAVA_HOME=/usr/lib/jvm/java-${JAVA_VERSION}-openjdk-amd64
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin
ENV PATH=${PATH}:${ANDROID_HOME}/platform-tools

ENV NODE_VERSION=26.13.0
ENV NVM_VERSION=0.40.0
ENV NVM_DIR=/root/.nvm
ENV PATH=${PATH}:${NVM_DIR}/versions/node/v${NODE_VERSION}/bin

RUN <<EOF
set -e

apt-get update --yes

apt-get install --yes --no-install-recommends ncurses-bin
apt-get install --yes --no-install-recommends curl
apt-get install --yes --no-install-recommends unzip

apt-get install --yes --no-install-recommends openjdk-${JAVA_VERSION}-jdk

mkdir -p ${ANDROID_HOME}/cmdline-tools
ZIP_FILE=commandlinetools-linux-${ANDROID_COMMAND_LINE_TOOLS_VERSION}_latest.zip
curl -fsSLO https://dl.google.com/android/repository/${ZIP_FILE}
unzip -q ${ZIP_FILE}
mv cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest
rm -rf ${ZIP_FILE}

yes | sdkmanager --licenses
sdkmanager "platform-tools"
sdkmanager "ndk;${ANDROID_NDK_VERSION}"
sdkmanager "build-tools;${ANDROID_BUILD_TOOLS_VERSION}"
sdkmanager "platforms;android-${ANDROID_PLATFORM_VERSION}"

curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash
. ${NVM_DIR}/nvm.sh
nvm install ${NODE_VERSION}

rm -rf /var/lib/apt/lists/*
EOF
