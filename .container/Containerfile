FROM docker.io/library/debian:stable-slim@sha256:dd324f2b5d8d63278a0ab2831193c0b2d192bc4d7f7a1879408fc51300546cdb

ENV JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/27.1.12297006
ENV PATH=$PATH:$ANDROID_HOME/platform-tools
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/15859902/bin

ENV NVM_DIR=/root/.nvm
ENV PATH=$PATH:$NVM_DIR/versions/node/v26.13.0/bin

RUN <<EOF
set -e

apt-get update --yes

apt-get install --yes --no-install-recommends ncurses-bin curl libarchive-tools

apt-get install --yes --no-install-recommends gpg ca-certificates
curl -fL https://apt.corretto.aws/corretto.key | gpg --dearmor -o /usr/share/keyrings/corretto-keyring.gpg
printf 'deb [signed-by=/usr/share/keyrings/corretto-keyring.gpg] https://apt.corretto.aws stable main\n' \
  > /etc/apt/sources.list.d/corretto.list
apt-get --yes update
apt-get install --yes java-21-amazon-corretto-jdk

mkdir -p $ANDROID_HOME/cmdline-tools/15859902
curl -fL https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip | \
  bsdtar --strip-components=1 -xpf - -C $ANDROID_HOME/cmdline-tools/15859902


rm -rf /var/lib/apt/lists/*
EOF
