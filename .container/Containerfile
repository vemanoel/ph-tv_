FROM docker.io/library/debian@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1

RUN <<EOF
set -e

apt-get update --yes

apt-get install --yes --no-install-recommends ncurses-bin
apt-get install --yes --no-install-recommends curl
apt-get install --yes --no-install-recommends unzip

rm -rf /var/lib/apt/lists/*
EOF

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/27.0.12077973
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools
RUN <<EOF
set -e

apt-get update --yes

apt-get install --yes --no-install-recommends openjdk-21-jdk

mkdir -p ${ANDROID_HOME}/cmdline-tools
curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o cmdline-tools.zip
unzip -q cmdline-tools.zip
mv cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest
rm -rf cmdline-tools.zip

rm -rf /var/lib/apt/lists/*
EOF

RUN yes | sdkmanager --licenses && sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0" "ndk;27.0.12077973"

ENV NODE_VERSION=26.13.0
ENV NVM_VERSION=0.40.0
ENV NVM_DIR=/root/.nvm
ENV PATH=${PATH}:${NVM_DIR}/versions/node/v${NODE_VERSION}/bin
RUN <<EOF
set -e

curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash
. ${NVM_DIR}/nvm.sh
nvm install ${NODE_VERSION}
EOF

ENV EXPO_NO_TYPESCRIPT_SETUP=1
